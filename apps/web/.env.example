# Required in production: long random string used to sign session cookies.
SESSION_SECRET=
# Postgres connection string (Vercel Postgres / Neon / Supabase). Without it,
# data lives in memory and is lost on restart (fine for local dev and demos).
DATABASE_URL=
# Sign-in codes by email via Resend. Without it, codes are logged to the server
# console, and shown on screen when DEMO_MODE=1.
RESEND_API_KEY=
MAIL_FROM="DNA Trails <hello@dnatrails.mk>"
# Payment provider: "mock" (default, nothing charged). Real provider not chosen yet.
PAYMENTS_PROVIDER=mock
# 1 = investor/partner demo: sample account button, codes shown on screen.
DEMO_MODE=1
